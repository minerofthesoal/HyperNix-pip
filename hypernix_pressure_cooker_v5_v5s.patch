 from hypernix.pressure_cooker_v5 import PressureCookerV5
 
 cooker = PressureCookerV5(
     model.parameters(),
-    peak_lr=2e-4,
-    quantize_momentum=True,  # Enable 6-bit quantized momentum
+    lr=2e-4,
 )
 ```
 
