```
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
.venv/
venv/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*
# ...but committed *templates* are the point: examples/t1api/.env.example
# documents every T1 API variable and ships in the sdist. The rule above
# is for real environment files, which never have a .example suffix.
!*.env.example
!.env.example
!**/.env.example

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Python specific
*.pyo
*.pyd
.Python
*.so
*.egg-info/

# System files
.DS_Store
Thumbs.db

# Build directories
build/
dist/
*.egg

# Cache directories
.mypy_cache/
.pytest_cache/
.coverage*/
# Website dependencies
docs/node_modules/
src/hypernix/node_modules/
docs/dist/

# --- iOS (ios/) ---
# The .xcodeproj is generated from ios/project.yml by XcodeGen, not
# committed: a pbxproj is a merge-conflict machine, and CI regenerates it
# from a clean checkout anyway.
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/DerivedData/
*.ipa
*.xcarchive
*.xcresult
